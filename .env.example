# ── 7TV ──────────────────────────────────────────────────────────────────────
# Session token for the TARGET account (the one you're adding emotes to).
# How to get it:
#   1. Log into 7tv.app with the target Twitch account
#   2. Open DevTools → Network → filter by "gql"
#   3. Click any request → Headers → copy the Authorization value (without "Bearer ")
SEVENTV_TOKEN=

# ── Twitch (app credentials — no user login required) ────────────────────────
# Create a free app at https://dev.twitch.tv/console/apps
# Use any redirect URL (e.g. http://localhost) — we only use Client Credentials.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
